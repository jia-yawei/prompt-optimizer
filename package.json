{
  "name": "prompt-optimizer",
  "version": "2.11.10",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": "^24.0.0",
    "npm": "Please use pnpm instead of npm",
    "yarn": "Please use pnpm instead of yarn"
  },
  "scripts": {
    "build": "node scripts/run-many.js build:core build:ui build:web",
    "build:core": "corepack pnpm -F @prompt-optimizer/core build",
    "build:ui": "corepack pnpm -F @prompt-optimizer/ui build",
    "build:web": "corepack pnpm -F @prompt-optimizer/web build",
    "build:pages": "node scripts/run-many.js build:core build:ui build:web:pages",
    "build:web:pages": "corepack pnpm -F @prompt-optimizer/web build:pages",
    "dev": "node scripts/run-many.js clean:dist build:core build:ui dev:web",
    "dev:web": "corepack pnpm -F @prompt-optimizer/web dev",
    "test": "corepack pnpm test:unit",
    "test:unit": "corepack pnpm -r test --run --passWithNoTests",
    "test:repo": "node --test scripts/run-many.test.mjs scripts/check-locale-parity.test.mjs scripts/check-no-chinese-runtime.test.mjs scripts/package-scripts.test.mjs scripts/middleware-auth.test.mjs scripts/workspace-select-config.test.mjs && corepack pnpm check:locale && corepack pnpm check:no-chinese-runtime",
    "check:locale": "node scripts/check-locale-parity.mjs",
    "check:no-chinese-runtime": "node scripts/check-no-chinese-runtime.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smart": "node scripts/smart-e2e.js",
    "test:e2e:ui-smoke": "cross-env E2E_VCR_MODE=live E2E_EMPTY_MODEL_CONFIG=1 node scripts/run-e2e-group.js uiSmoke",
    "test:e2e:gate": "node scripts/run-e2e-group.js gate",
    "test:e2e:gate:replay": "cross-env E2E_VCR_MODE=replay node scripts/run-e2e-group.js gate",
    "test:e2e:extended": "node scripts/run-e2e-group.js extended",
    "test:e2e:record": "node scripts/run-e2e-record.js",
    "test:e2e:replay": "cross-env E2E_VCR_MODE=replay node scripts/run-e2e-group.js extended",
    "test:gate:core": "corepack pnpm -F @prompt-optimizer/core test:gate",
    "test:gate:ui": "corepack pnpm -F @prompt-optimizer/core build && corepack pnpm -F @prompt-optimizer/ui test",
    "test:gate:e2e": "node scripts/run-many.js -s test:e2e:ui-smoke test:e2e:gate:replay",
    "test:gate": "node scripts/run-many.js -s test:repo test:gate:core test:gate:ui",
    "test:gate:full": "node scripts/run-many.js -s test:gate test:gate:e2e",
    "test:fast": "corepack pnpm -r test --run --passWithNoTests",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "clean": "node scripts/run-many.js clean:dist clean:vite",
    "clean:dist": "rimraf packages/core/dist packages/ui/dist packages/web/dist",
    "clean:vite": "rimraf packages/core/node_modules/.vite packages/ui/node_modules/.vite packages/web/node_modules/.vite",
    "pnpm-install": "corepack pnpm install",
    "version:sync": "node scripts/sync-versions.js",
    "version": "corepack pnpm run version:sync && git add -A",
    "version:prepare": "corepack pnpm version --no-git-tag-version",
    "version:tag": "git tag v$(node -p \"require('./package.json').version\")",
    "version:publish": "git push origin v$(node -p \"require('./package.json').version\")",
    "release:notes:new": "node scripts/release-notes.js new",
    "release:notes:check": "node scripts/release-notes.js check",
    "release:notes:check:entry": "node scripts/release-notes.js check-entry",
    "release:notes:render-body": "node scripts/release-notes.js render-body",
    "lint": "node scripts/run-many.js lint:ui typecheck:ui typecheck:core build:ui-types typecheck:web",
    "lint:ui": "corepack pnpm -F @prompt-optimizer/ui lint",
    "lint:fix": "corepack pnpm -F @prompt-optimizer/ui lint:fix",
    "build:ui-types": "corepack pnpm -F @prompt-optimizer/ui build:types",
    "typecheck:ui": "corepack pnpm -F @prompt-optimizer/ui typecheck",
    "typecheck:core": "corepack pnpm -F @prompt-optimizer/core typecheck",
    "typecheck:web": "corepack pnpm -F @prompt-optimizer/web typecheck",
    "kill:dev": "node scripts/kill-dev.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
